# Spike image for items 5 to 8. NOT the v1 image: tags instead of digests, and
# the Node base image instead of debian:stable-slim plus Node (CLAUDE.md 2.3).
# Build: container build --build-arg OPENCODE_VERSION=<exact> -t sc-spike-opencode:dev -f Containerfile .
FROM docker.io/library/node:22-bookworm-slim

ARG OPENCODE_VERSION
RUN apt-get update \
 && apt-get install -y --no-install-recommends git ripgrep ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && npm install -g "opencode-ai@${OPENCODE_VERSION}" \
 && npm cache clean --force \
 && useradd --create-home --uid 1001 --shell /bin/bash agent \
 && mkdir /workspace && chown agent:agent /workspace

USER agent
WORKDIR /workspace
